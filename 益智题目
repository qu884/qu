class SnakeGame : public QMainWindow
{
    Q_OBJECT

public:
    SnakeGame(QWidget *parent = nullptr)
        : QMainWindow(parent), direction(1), gameOver(false), paused(false), score(0)
    {
        setWindowTitle("贪吃蛇游戏");
        setFixedSize(cols * gridSize, rows * gridSize);
        timer = new QTimer(this);
        connect(timer, &QTimer::timeout, this, &SnakeGame::updateGame);
        initGame();
    }

    ~SnakeGame() { delete timer; }

private slots:
    void updateGame()
    {
        if (!gameOver && !paused) {
            moveSnake();
            if (checkCollision()) {
                gameOver = true;
                timer->stop();
            } else if (snake.first() == food) {
                score += 10;
                snake.append(snake.last());
                generateFood();
            }
        }
        repaint();
    }

protected:
    void paintEvent(QPaintEvent *event)
    {
        Q_UNUSED(event);
        QPainter painter(this);
        painter.fillRect(rect(), Qt::black);
        for (const QPoint &point : snake) {
            painter.fillRect(point.x() * gridSize, point.y() * gridSize, gridSize - 1, gridSize - 1, Qt::green);
        }
        painter.fillRect(food.x() * gridSize, food.y() * gridSize, gridSize - 1, gridSize - 1, Qt::red);
        if (gameOver) {
            painter.setPen(Qt::white);
            painter.setFont(QFont("Arial", 20));
            painter.drawText(rect(), Qt::AlignCenter, QString("游戏结束!\n分数: %1\n按空格重新开始").arg(score));
        } else if (paused) {
            painter.setPen(Qt::white);
            painter.setFont(QFont("Arial", 20));
            painter.drawText(rect(), Qt::AlignCenter, "暂停\n按空格继续");
        }
    }

    void keyPressEvent(QKeyEvent *event)
    {
        switch (event->key()) {
        case Qt::Key_Up:
            if (direction != 2) direction = 0;
            break;
        case Qt::Key_Right:
            if (direction != 3) direction = 1;
            break;
        case Qt::Key_Down:
            if (direction != 0) direction = 2;
            break;
        case Qt::Key_Left:
            if (direction != 1) direction = 3;
            break;
        case Qt::Key_Space:
            if (gameOver) initGame();
            else paused = !paused;
            break;
        case Qt::Key_Escape:
            close();
            break;
        }
    }

private:
    void initGame()
    {
        snake.clear();
        snake.append(QPoint(cols / 2, rows / 2));
        snake.append(QPoint(cols / 2 - 1, rows / 2));
        snake.append(QPoint(cols / 2 - 2, rows / 2));
        direction = 1;
        gameOver = false;
        paused = false;
        score = 0;
        generateFood();
        timer->start(150);
    }

    void generateFood()
    {
        int x, y;
        do {
            x = rand() % cols;
            y = rand() % rows;
        } while (snake.contains(QPoint(x, y)));
        food = QPoint(x, y);
    }

    void moveSnake()
    {
        QPoint head = snake.first();
        switch (direction) {
        case 0: head.ry()--; break;
        case 1: head.rx()++; break;
        case 2: head.ry()++; break;
        case 3: head.rx()--; break;
        }
        snake.prepend(head);
        snake.removeLast();
    }

    bool checkCollision()
    {
        QPoint head = snake.first();
        if (head.x() < 0 || head.x() >= cols || head.y() < 0 || head.y() >= rows) return true;
        for (int i = 1; i < snake.size(); i++) {
            if (snake[i] == head) return true;
        }
        return false;
    }

    QTimer *timer;
    QVector<QPoint> snake;
    QPoint food;
    int direction;
    bool gameOver;
    bool paused;
    int score;
    const int gridSize = 20;
    const int rows = 20;
    const int cols = 20;
};

#include <QString>
#include <QVector>
#include <ctime>

class PuzzleGenerator {
public:
    enum PuzzleType {
        MATH_ARITHMETIC,
        MATH_SEQUENCE,
        LOGIC_TRUE_FALSE,
        LOGIC_REASONING,
        WORD_IDIOM,
        WORD_RIDDLE,
        GENERAL_KNOWLEDGE,
        COUNTING_PUZZLE
    };

    struct Puzzle {
        QString question;
        QString answer;
        QString options[4];
        int correctIndex;
        PuzzleType type;
        QString hint;
    };

    PuzzleGenerator() {
        srand(time(0));
    }

    Puzzle generatePuzzle(PuzzleType type = MATH_ARITHMETIC) {
        Puzzle puzzle;
        puzzle.type = type;

        switch(type) {
        case MATH_ARITHMETIC:
            return generateArithmeticPuzzle();
        case MATH_SEQUENCE:
            return generateSequencePuzzle();
        case LOGIC_TRUE_FALSE:
            return generateTrueFalsePuzzle();
        case LOGIC_REASONING:
            return generateReasoningPuzzle();
        case WORD_IDIOM:
            return generateIdiomPuzzle();
        case WORD_RIDDLE:
            return generateRiddlePuzzle();
        case GENERAL_KNOWLEDGE:
            return generateKnowledgePuzzle();
        case COUNTING_PUZZLE:
            return generateCountingPuzzle();
        default:
            return generateArithmeticPuzzle();
        }
    }

    Puzzle generateRandomPuzzle() {
        int type = rand() % 8;
        return generatePuzzle(static_cast<PuzzleType>(type));
    }

    QString getTypeName(PuzzleType type) {
        switch(type) {
        case MATH_ARITHMETIC: return "数学运算";
        case MATH_SEQUENCE: return "数字序列";
        case LOGIC_TRUE_FALSE: return "逻辑判断";
        case LOGIC_REASONING: return "逻辑推理";
        case WORD_IDIOM: return "成语填空";
        case WORD_RIDDLE: return "字谜";
        case GENERAL_KNOWLEDGE: return "常识问答";
        case COUNTING_PUZZLE: return "计数谜题";
        default: return "未知类型";
        }
    }

private:
    Puzzle generateArithmeticPuzzle() {
        Puzzle p;
        int a = rand() % 50 + 1;
        int b = rand() % 50 + 1;
        int op = rand() % 4;

        QString ops[] = {"+", "-", "*", "/"};
        int answer;

        switch(op) {
        case 0: answer = a + b; break;
        case 1: 
            if (a < b) qSwap(a, b);
            answer = a - b; 
            break;
        case 2: answer = a * b; break;
        case 3: 
            b = rand() % 10 + 1;
            answer = a * b;
            a = answer;
            break;
        }

        p.question = QString("%1 %2 %3 = ?").arg(a).arg(ops[op]).arg(b);
        p.answer = QString::number(answer);
        
        generateOptions(p, answer, 0, answer * 2 + 10);
        p.hint = QString("使用基本%1运算").arg(op == 0 ? "加法" : op == 1 ? "减法" : op == 2 ? "乘法" : "除法");
        return p;
    }

    Puzzle generateSequencePuzzle() {
        Puzzle p;
        int type = rand() % 5;
        QString seqStr;
        int answer;

        switch(type) {
        case 0: {
            int a = rand() % 5 + 1;
            int d = rand() % 5 + 1;
            seqStr = QString("%1, %2, %3, %4, ?").arg(a).arg(a+d).arg(a+2*d).arg(a+3*d);
            answer = a + 4 * d;
            break;
        }
        case 1: {
            int a = rand() % 3 + 1;
            seqStr = QString("%1, %2, %3, %4, ?").arg(a).arg(a*2).arg(a*4).arg(a*8);
            answer = a * 16;
            break;
        }
        case 2: {
            int n = rand() % 5 + 3;
            seqStr = QString("%1, %2, %3, %4, ?").arg(n*n-1).arg(n*n+1).arg((n+1)*(n+1)-1).arg((n+1)*(n+1)+1);
            answer = (n+2)*(n+2)-1;
            break;
        }
        case 3: {
            int a = 1, b = 1;
            seqStr = "1, 1, ";
            for(int i=2; i<5; i++) {
                int c = a + b;
                seqStr += QString::number(c) + (i < 4 ? ", " : ", ?");
                a = b; b = c;
            }
            answer = a + b;
            break;
        }
        default: {
            int start = rand() % 10 + 1;
            seqStr = QString("%1, %2, %3, %4, ?").arg(start).arg(start*2).arg(start*3).arg(start*4);
            answer = start * 5;
            break;
        }
        }

        p.question = QString("找出数列规律：%1").arg(seqStr);
        p.answer = QString::number(answer);
        generateOptions(p, answer, answer-20, answer+20);
        p.hint = "观察相邻数字之间的关系";
        return p;
    }

    Puzzle generateTrueFalsePuzzle() {
        Puzzle p;
        struct TFQuestion {
            QString question;
            bool answer;
            QString hint;
        };

        QVector<TFQuestion> questions = {
            {"太阳从西边升起", false, "想想每天早上看到的景象"},
            {"水在标准大气压下100°C会沸腾", true, "基本物理常识"},
            {"一年有365天", false, "闰年有366天"},
            {"地球是圆的", true, "宇航员从太空看到的样子"},
            {"正方形有三条边", false, "数一下正方形的边"},
            {"人类有两只眼睛", true, "照镜子看看"},
            {"冰会在高温下融化", true, "夏天的雪糕"},
            {"月亮会自己发光", false, "月亮是反射太阳光"},
            {"1米等于100厘米", true, "长度单位换算"},
            {"鱼可以在陆地上呼吸", false, "鱼用鳃呼吸"},
            {"中国的首都是北京", true, "国家常识"},
            {"三角形内角和是180度", true, "几何基本定理"}
        };

        int idx = rand() % questions.size();
        p.question = questions[idx].question + "（对/错）";
        p.answer = questions[idx].answer ? "对" : "错";
        p.options[0] = "对";
        p.options[1] = "错";
        p.options[2] = "不确定";
        p.options[3] = "以上都不对";
        p.correctIndex = questions[idx].answer ? 0 : 1;
        p.hint = questions[idx].hint;
        return p;
    }

