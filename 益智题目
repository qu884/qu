            {"比喻做事有始有终", "有始有终", {"有始有终", "半途而废", "虎头蛇尾", "善始善终"}},
            {"形容非常高兴", "兴高采烈", {"兴高采烈", "垂头丧气", "闷闷不乐", "愁眉苦脸"}},
            {"比喻知己或知音", "知音难觅", {"知音难觅", "志同道合", "莫逆之交", "生死之交"}},
            {"形容学习刻苦", "悬梁刺股", {"悬梁刺股", "闻鸡起舞", "凿壁偷光", "囊萤映雪"}},
            {"比喻做事不切实际", "好高骛远", {"好高骛远", "脚踏实地", "实事求是", "稳扎稳打"}},
            {"形容时间过得快", "光阴似箭", {"光阴似箭", "度日如年", "日月如梭", "白驹过隙"}},
            {"比喻团结就是力量", "众志成城", {"众志成城", "分崩离析", "各自为政", "孤军奋战"}}
