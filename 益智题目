    }

    Puzzle generateCountingPuzzle() {
        Puzzle p;
        int a = rand() % 10 + 1;
        int b = rand() % 10 + 1;
        int c = rand() % 10 + 1;

        QString shapes[] = {"圆形", "正方形", "三角形", "长方形", "五角星"};
        QString shape1 = shapes[rand() % 5];
        QString shape2 = shapes[rand() % 5];
        QString shape3 = shapes[rand() % 5];

        p.question = QString("盒子里有%1个%2，%3个%4，%5个%6，总共有多少个图形？")
                     .arg(a).arg(shape1).arg(b).arg(shape2).arg(c).arg(shape3);
        p.answer = QString::number(a + b + c);
        generateOptions(p, a + b + c, 0, 30);
        p.hint = QString("%1+%2+%3").arg(a).arg(b).arg(c);
        return p;
    }

    void generateOptions(Puzzle &p, int correctAnswer, int min, int max) {
        QVector<int> nums;
        nums.append(correctAnswer);

        while(nums.size() < 4) {
            int num = min + rand() % (max - min + 1);
            if(!nums.contains(num)) {
                nums.append(num);
            }
        }

        for(int i=0; i<4; i++) {
            int idx = rand() % nums.size();
            p.options[i] = QString::number(nums[idx]);
            if(nums[idx] == correctAnswer) p.correctIndex = i;
            nums.remove(idx);
        }
    }
};

int main(int argc, char *argv[])
{
    QApplication a(argc, argv);
    
    PuzzleGenerator generator;
    
    for(int i=0; i<5; i++) {
        auto puzzle = generator.generateRandomPuzzle();
        printf("题目%d [%s]: %s\n", i+1, 
               generator.getTypeName(puzzle.type).toUtf8().constData(),
               puzzle.question.toUtf8().constData());
        printf("选项: ");
        for(int j=0; j<4; j++) {
            printf("[%d]%s ", j+1, puzzle.options[j].toUtf8().constData());
        }
        printf("\n答案: %s\n提示: %s\n\n", 
               puzzle.answer.toUtf8().constData(),
               puzzle.hint.toUtf8().constData());
    }
    
    SnakeGame w;
    w.show();
    return a.exec();
}

