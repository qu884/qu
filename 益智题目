    Puzzle generateKnowledgePuzzle() {
        Puzzle p;
        struct Knowledge {
            QString question;
            QString answer;
            QString options[4];
        };

        QVector<Knowledge> questions = {
            {"中国最长的河流是？", "长江", {"长江", "黄河", "珠江", "黑龙江"}},
            {"地球绕太阳转一圈需要多久？", "一年", {"一天", "一个月", "一年", "一百年"}},
            {"水的化学式是？", "H2O", {"H2O", "CO2", "O2", "NaCl"}},
            {"世界上最大的海洋是？", "太平洋", {"大西洋", "太平洋", "印度洋", "北冰洋"}},
